@model List<Course>
@{ ViewData["Title"] = "Courses"; }
<section class="listing-heading"><div><p class="eyebrow">Learning</p><h1>Courses</h1><p>Find and update the courses in your catalog.</p></div><a asp-action="Create" class="btn btn-primary">Add course</a></section>
@if (Model.Count == 0)
{
    <div class="listing-empty"><h2>No courses yet</h2><p>Create a course to start the catalog.</p><a asp-action="Create" class="btn btn-primary">Add course</a></div>
}
else
{
    <div class="table-responsive"><table class="table table-striped table-hover mb-0">
        <thead><tr><th scope="col">ID</th><th scope="col">Course</th><th scope="col">Code</th><th scope="col">Credit hours</th><th scope="col">Actions</th></tr></thead>
        <tbody>@foreach (var course in Model)
        {
            <tr><td class="text-muted">#@course.Id</td><td class="fw-semibold">@course.Name</td><td><span class="course-code">@course.Code</span></td><td>@course.CreditHours</td><td><div class="d-flex gap-2 flex-wrap"><a asp-action="Details" asp-route-id="@course.Id" class="btn btn-outline-secondary btn-sm">Details</a><a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-outline-secondary btn-sm">Edit</a><a asp-action="Delete" asp-route-id="@course.Id" class="btn btn-outline-danger btn-sm">Delete</a></div></td></tr>
        }</tbody>
    </table></div>
}
