@model List<Course>
<table>
    <tr>
        <th>id</th>
        <th>name</th>
        <th>code</th>
        <th>CreditHours</th>
    </tr>
    @foreach (var x in Model) { 
        <tr>
            <td>@x.Id</td>
            <td>@x.Name</td>
            <td>@x.Code</td>
            <td>@x.CreditHours</td>
        </tr>
    }
</table>