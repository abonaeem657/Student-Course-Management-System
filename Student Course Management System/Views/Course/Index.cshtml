@model List<Course>
<a asp-action="Create">Create New Course</a>
<table>
    <tr>
        <th>id</th>
        <th>name</th>
        <th>code</th>
        <th>CreditHours</th>
    </tr>
    @foreach (var x in Model) { 
        <tr>
            <td>@x.Id</td>
            <td>@x.Name</td>
            <td>@x.Code</td>
            <td>@x.CreditHours</td>
            <td><a asp-action="Details" asp-route-id="@x.Id">Details</a></td>
            <td><a asp-action="Edit" asp-route-id="@x.Id">Edit</a></td>
            <td><a asp-action="Delete" asp-route-id="@x.Id">Delete</a></td>
        </tr>
    }
</table>