@model Course
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
    </div>
    <div>
        <label asp-for="Code"></label>
        <input asp-for="Code" />
    </div>
    <div>
        <label asp-for="CreditHours"></label>
        <input asp-for="CreditHours" />
    </div>
    <button type="submit">Save</button>
</form>