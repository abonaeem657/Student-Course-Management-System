@model List<Enrollment>
<a asp-action="Create">Create New Enrollment</a>
<table class="table table-striped table-bordered table-hover">
    <tr>
        <th>id</th>
        <th>student_name</th>
        <th>course_name</th>
        <th>Delete</th>
    </tr>
    @foreach (var x in Model)
    {
        <tr>
            <td>@x.Id</td>
            <td>@x.Student.Name</td>
            <td>@x.Course.Name</td>
            <td>
                <a asp-action="Delete" asp-route-id="@x.Id">Delete</a>
            </td>
        </tr>
    }
</table>