@model List<Enrollment>
@{ ViewData["Title"] = "Enrollments"; }
<section class="listing-heading"><div><p class="eyebrow">Connections</p><h1>Enrollments</h1><p>See which students are connected to each course.</p></div><a asp-action="Create" class="btn btn-primary">Add enrollment</a></section>
@if (Model.Count == 0)
{
    <div class="listing-empty"><h2>No enrollments yet</h2><p>Enroll a student in a course to see it here.</p><a asp-action="Create" class="btn btn-primary">Add enrollment</a></div>
}
else
{
    <div class="table-responsive"><table class="table table-striped table-hover mb-0">
        <thead><tr><th scope="col">ID</th><th scope="col">Student</th><th scope="col">Course</th><th scope="col">Actions</th></tr></thead>
        <tbody>@foreach (var enrollment in Model)
        {
            <tr><td class="text-muted">#@enrollment.Id</td><td class="fw-semibold">@enrollment.Student?.Name</td><td>@enrollment.Course?.Name</td><td><div class="d-flex gap-2 flex-wrap"><a asp-action="Edit" asp-route-id="@enrollment.Id" class="btn btn-outline-secondary btn-sm">Edit</a><a asp-action="Delete" asp-route-id="@enrollment.Id" class="btn btn-outline-danger btn-sm">Delete</a></div></td></tr>
        }</tbody>
    </table></div>
}
