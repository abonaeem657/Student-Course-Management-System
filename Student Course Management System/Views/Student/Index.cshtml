@model List<Student>
@{ ViewData["Title"] = "Students"; }
<section class="listing-heading"><div><p class="eyebrow">People</p><h1>Students</h1><p>Manage student profiles and majors in one place.</p></div><a asp-action="Create" class="btn btn-primary">Add student</a></section>
@if (Model.Count == 0)
{
    <div class="listing-empty"><h2>No students yet</h2><p>Add a student to start building your records.</p><a asp-action="Create" class="btn btn-primary">Add student</a></div>
}
else
{
    <div class="table-responsive"><table class="table table-striped table-hover mb-0">
        <thead><tr><th scope="col">ID</th><th scope="col">Student</th><th scope="col">Major</th><th scope="col">Actions</th></tr></thead>
        <tbody>@foreach (var student in Model)
        {
            <tr><td class="text-muted">#@student.Id</td><td class="fw-semibold">@student.Name</td><td>@student.Major</td><td><div class="d-flex gap-2 flex-wrap"><a asp-action="Detail" asp-route-id="@student.Id" class="btn btn-outline-secondary btn-sm">Details</a><a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-outline-secondary btn-sm">Edit</a><a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-outline-danger btn-sm">Delete</a></div></td></tr>
        }</tbody>
    </table></div>
}
