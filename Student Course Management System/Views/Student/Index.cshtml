@model List<Student>

<a asp-action="Create" class="btn btn-primary mb-3">
    Create New Student
</a>

<table class="table table-striped table-bordered table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Major</th>
            <th>Details</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.Id</td>
                <td>@x.Name</td>
                <td>@x.Major</td>

                <td>
                    <a asp-action="Detail"
                       asp-route-id="@x.Id"
                       class="btn btn-info btn-sm">
                        Details
                    </a>
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@x.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>
                </td>

                <td>
                    <a asp-action="Delete"
                       asp-route-id="@x.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>`