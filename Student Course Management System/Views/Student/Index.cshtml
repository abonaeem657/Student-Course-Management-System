@model List<Student>
<table border="0">
    <tr><th>Id</th><th>Name</th><th>Major</th></tr>
@foreach (var x in @Model)
{
    <tr>
        <td>@x.Id</td>
        <td>@x.Name</td>
        <td>@x.Major</td>
        <td><a asp-action="Detail" asp-route-id="@x.Id">View Details</a></td>
        <td><a asp-action="Edit" asp-route-id="@x.Id">Edit</a></td>
        <td><a asp-action="Edit" asp-route-id="@x.Id">Delete</a></td>
    </tr>
}
<tfoot><a asp-action="Create">Create New Student</a></tfoot>
</table>