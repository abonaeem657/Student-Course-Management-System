@model Student

<form asp-action="Create" method="post">

   

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div>
        <label asp-for="Major"></label>
        <input asp-for="Major" />
        <span asp-validation-for="Major"></span>
    </div>

    <button type="submit">Save</button>

</form>